# Line endings: LF in the index and in every checkout, whatever core.autocrlf says.
* text=auto eol=lf

*.c.inc         diff=c
*.h.inc         diff=c
*.m             diff=objc
*.py            diff=python
*.rs            diff=rust
*.rs.inc        diff=rust
Cargo.lock      diff=toml merge=binary

*.patch         -text -whitespace
